<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/viewDismiss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/func_black_alpha_1" />

    <LinearLayout
        android:id="@+id/llQuickPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_gray3_surface_bottom_round_1"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dp_20">

        <LinearLayout
            android:id="@+id/llQuickHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/dp_16">

            <TextView
                android:id="@+id/tvQuickTitle"
                style="@style/tv_black_1_size_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:layout_weight="1"
                android:text="@string/quick_menu_title" />

            <com.joy.common.widgets.IconFontView
                android:id="@+id/iconClose"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/iconfont_close"
                android:textColor="@color/func_black_text_2"
                android:textSize="@dimen/dp_16" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/func_black_border_2" />

        <GridView
            android:id="@+id/gvMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:horizontalSpacing="@dimen/dp_8"
            android:numColumns="4"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingTop="@dimen/dp_12"
            android:verticalSpacing="@dimen/dp_16" />
    </LinearLayout>
</FrameLayout>
