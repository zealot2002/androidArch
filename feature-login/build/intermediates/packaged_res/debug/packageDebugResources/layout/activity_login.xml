<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/func_surface_paper_1">

    <!-- Logo区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="60dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_gray_surface_card_1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lego架构 Demo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/func_black_text_1"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- 表单区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 手机号输入 -->
        <EditText
            android:id="@+id/et_phone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="请输入手机号"
            android:inputType="phone"
            android:maxLength="11"
            android:background="@drawable/bg_gray_field_rect_1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="16sp"
            android:textColor="@color/func_black_text_1" />

        <!-- 密码输入 -->
        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="请输入密码"
            android:inputType="textPassword"
            android:background="@drawable/bg_gray_field_rect_1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textSize="16sp"
            android:textColor="@color/func_black_text_1"
            android:layout_marginTop="16dp" />

        <!-- 登录按钮 -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="登录"
            android:textSize="18sp"
            android:textColor="@color/func_white_text_1"
            android:background="@drawable/sel_orange_interact_capsule_emphasis_default"
            android:layout_marginTop="32dp" />

        <!-- 注册链接 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还没有账号？"
                android:textSize="14sp"
                android:textColor="@color/func_black_text_3" />

            <TextView
                android:id="@+id/tv_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="立即注册"
                android:textSize="14sp"
                android:textColor="@color/func_orange_text_1"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- 测试账号提示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试账号：13800138000"
                android:textSize="12sp"
                android:textColor="@color/func_black_text_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码：123456"
                android:textSize="12sp"
                android:textColor="@color/func_black_text_4"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>