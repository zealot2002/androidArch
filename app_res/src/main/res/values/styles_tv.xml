<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ====================== 基础基类 ====================== -->
    <!-- 默认 wrap 宽高（多数场景）。列表/表单里要撑满一行时在布局写 android:layout_width="match_parent"。 -->
    <style name="tv_base" tools:ignore="ResourceName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ====================== 黑色文字（主文本） ====================== -->
    <style name="tv_black_1" parent="tv_base" tools:ignore="ResourceName">
        <item name="android:textColor">@color/func_black_text_1</item>
    </style>
    <style name="tv_black_2" parent="tv_base" tools:ignore="ResourceName">
        <item name="android:textColor">@color/func_black_text_2</item>
    </style>
    <style name="tv_black_3" parent="tv_base" tools:ignore="ResourceName">
        <item name="android:textColor">@color/func_black_text_3</item>
    </style>

    <!-- ====================== 灰色文字（辅助/提示） ====================== -->
