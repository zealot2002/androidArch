<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/anchorSectionProduct"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gray_2"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_toEndOf="@id/tvYen"
            android:includeFontPadding="false"
            android:textColor="@color/orange_1"
            android:textSize="@dimen/dp_28"
            android:textStyle="bold"
            tools:text="98.00" />

        <TextView
            android:id="@+id/tvYen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tvPrice"
            android:layout_alignParentStart="true"
            android:includeFontPadding="false"
            android:text="¥"
            android:textColor="@color/orange_1"
            android:textSize="@dimen/dp_14"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOriginalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tvPrice"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_toEndOf="@id/tvPrice"
            android:layout_toStartOf="@id/tvStatusTag"
            android:includeFontPadding="false"
            android:textColor="@color/black_3"
            android:textSize="@dimen/dp_12"
            tools:text="¥158.00" />

        <TextView
            android:id="@+id/tvStatusTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tvPrice"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_red_field_rect_1"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_2"
            android:textColor="@color/red_1"
            android:textSize="@dimen/dp_11"
            tools:text="热销中" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutCoupon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/bg_red_field_rect_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_12">

        <TextView
            android:id="@+id/tvCouponIcon"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:background="@color/red_1"
            android:gravity="center"
            android:text="券"
            android:textColor="@color/white_1"
            android:textSize="@dimen/dp_11"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCouponText"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:textColor="@color/red_1"
            android:textSize="@dimen/dp_12"
            tools:text="满199减20" />

        <com.joy.common.widgets.IconFontView
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:gravity="center"
            android:text="@string/iconfont_arrow_down"
            android:textColor="@color/red_1"
            android:textSize="@dimen/dp_14" />
    </LinearLayout>
</LinearLayout>
