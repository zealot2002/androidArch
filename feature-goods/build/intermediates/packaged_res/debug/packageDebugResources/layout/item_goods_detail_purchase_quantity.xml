<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/func_gray_bg_2"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_12">

    <TextView
        style="@style/tv_black_1_size_14"
        android:text="@string/goods_quantity_label" />

    <View
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_1"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_32"
        android:background="@drawable/bg_gray_fill_interact_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_2">

        <TextView
            android:id="@+id/btnMinus"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/goods_quantity_minus"
            style="@style/tv_black_1_size_18" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="@dimen/dp_36"
            android:gravity="center"
            style="@style/tv_black_1_size_14"
            tools:text="1" />

        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/goods_quantity_plus"
            style="@style/tv_black_1_size_18" />
    </LinearLayout>
</LinearLayout>
