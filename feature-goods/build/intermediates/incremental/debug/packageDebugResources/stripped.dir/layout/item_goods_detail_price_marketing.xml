<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/anchorSectionProduct"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/func_gray_bg_2"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvPrice"
            style="@style/tv_orange_1_size_28"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/dp_2"
            android:layout_toEndOf="@id/tvYen"
            android:includeFontPadding="false"
            android:textStyle="bold"
            tools:text="98.00" />

        <TextView
            android:id="@+id/tvYen"
            style="@style/tv_orange_1_size_14"
            android:layout_alignBaseline="@id/tvPrice"
            android:layout_alignParentStart="true"
            android:includeFontPadding="false"
            android:text="@string/goods_price_yuan_symbol"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOriginalPrice"
            style="@style/tv_black_3_size_12"
            android:layout_alignBaseline="@id/tvPrice"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_toEndOf="@id/tvPrice"
            android:layout_toStartOf="@id/tvStatusTag"
            android:includeFontPadding="false"
            tools:text="¥158.00" />

        <TextView
            android:id="@+id/tvStatusTag"
            style="@style/tv_red_1_size_11"
            android:layout_alignBaseline="@id/tvPrice"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_red2_surface_tag_2"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/dp_8"
            android:paddingVertical="@dimen/dp_2"
            tools:text="热销中" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutCoupon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_10"
        android:background="@drawable/bg_red2_surface_tag_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_12">

        <TextView
            android:id="@+id/tvCouponIcon"
            style="@style/tv_white_1_size_11"
            android:background="@drawable/bg_red_field_rect_1"
            android:gravity="center"
            android:minWidth="@dimen/dp_18"
            android:minHeight="@dimen/dp_18"
            android:text="@string/goods_coupon_icon"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCouponText"
            style="@style/tv_red_1_size_12"
            android:layout_width="@dimen/dp_0"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            tools:text="满199减20" />

        <com.joy.common.widgets.IconFontView
            style="@style/tv_red_1_size_14"
            android:text="@string/iconfont_row_chevron"
            />
    </LinearLayout>
</LinearLayout>
