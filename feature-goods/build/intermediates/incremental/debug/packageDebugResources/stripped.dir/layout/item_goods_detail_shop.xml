<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/func_gray_bg_2"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_18"
    android:paddingBottom="@dimen/dp_18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            app:cardBackgroundColor="@color/func_green_bg_1"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="@dimen/dp_0">

            <ImageView
                android:id="@+id/ivShopLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/goods_shop_logo_cd"
                android:scaleType="centerCrop"
                tools:background="@color/func_green_bg_2" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShopName"
                    style="@style/tv_black_1_size_14"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold"
                    tools:text="易店园官方旗舰店" />

                <TextView
                    android:id="@+id/tvSelfOperatedTag"
                    style="@style/tv_white_1_size_10"
                    android:layout_marginStart="@dimen/dp_6"
                    android:background="@drawable/bg_orange_surface_tag_1"
                    android:paddingHorizontal="@dimen/dp_4"
                    android:paddingVertical="@dimen/dp_2"
                    android:textStyle="bold"
                    tools:text="自营" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFollowers"
                    style="@style/tv_black_3_size_12"
                    tools:text="粉丝 12.5万" />

                <TextView
                    android:id="@+id/tvItemCount"
                    style="@style/tv_black_3_size_12"
                    android:layout_marginStart="@dimen/dp_12"
                    tools:text="全部宝贝 156" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnEnterShop"
            style="@style/tv_orange_1_size_12"
            android:background="@drawable/bg_orange_stroke_interact_1"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_6"
            tools:text="进店逛逛" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/bg_gray_field_rect_1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_10">

        <LinearLayout
            android:id="@+id/layoutRatingDesc"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRatingDescLabel"
                style="@style/tv_black_3_size_12"
                tools:text="宝贝描述" />

            <TextView
                android:id="@+id/tvRatingDescScore"
                style="@style/tv_orange_1_size_12"
                android:layout_marginStart="@dimen/dp_4"
                android:textStyle="bold"
                tools:text="4.9" />

            <TextView
                android:id="@+id/tvRatingDescLevel"
                style="@style/tv_orange_1_size_11"
                android:layout_marginStart="@dimen/dp_4"
                android:background="@drawable/bg_orange_fill_interact_3"
                android:paddingHorizontal="@dimen/dp_4"
                android:paddingVertical="@dimen/dp_1"
                tools:text="高" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRatingService"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRatingServiceLabel"
                style="@style/tv_black_3_size_12"
                tools:text="卖家服务" />

            <TextView
                android:id="@+id/tvRatingServiceScore"
                style="@style/tv_orange_1_size_12"
                android:layout_marginStart="@dimen/dp_4"
                android:textStyle="bold"
                tools:text="4.8" />

            <TextView
                android:id="@+id/tvRatingServiceLevel"
                style="@style/tv_orange_1_size_11"
                android:layout_marginStart="@dimen/dp_4"
                android:background="@drawable/bg_orange_fill_interact_3"
                android:paddingHorizontal="@dimen/dp_4"
                android:paddingVertical="@dimen/dp_1"
                tools:text="高" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRatingLogistics"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRatingLogisticsLabel"
                style="@style/tv_black_3_size_12"
                tools:text="物流服务" />

            <TextView
                android:id="@+id/tvRatingLogisticsScore"
                style="@style/tv_orange_1_size_12"
                android:layout_marginStart="@dimen/dp_4"
                android:textStyle="bold"
                tools:text="4.9" />

            <TextView
                android:id="@+id/tvRatingLogisticsLevel"
                style="@style/tv_orange_1_size_11"
                android:layout_marginStart="@dimen/dp_4"
                android:background="@drawable/bg_orange_fill_interact_3"
                android:paddingHorizontal="@dimen/dp_4"
                android:paddingVertical="@dimen/dp_1"
                tools:text="高" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
