<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/func_gray_bg_2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowReviewHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_8">

        <TextView
            android:id="@+id/tvReviewTitle"
            style="@style/tv_black_1_size_16"
            android:textStyle="bold"
            tools:text="宝贝评价 (856)" />

        <TextView
            android:id="@+id/tvPositiveRate"
            style="@style/tv_orange_1_size_12"
            android:layout_marginStart="@dimen/dp_8"
            tools:text="好评率 98%" />

        <View
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_1"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/llViewAllReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvViewAllReviews"
                style="@style/tv_orange_1_size_12"
                android:text="@string/goods_review_view_all" />

            <com.joy.common.widgets.IconFontView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_2"
                android:text="@string/iconfont_row_chevron"
                android:textColor="@color/func_orange_text_1"
                android:textSize="@dimen/dp_12" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flReviewTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_12"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                app:cardBackgroundColor="@color/func_gray_bg_1"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="@dimen/dp_0">

                <ImageView
                    android:id="@+id/ivReviewAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/goods_review_avatar_cd"
                    android:scaleType="centerCrop"
                    tools:background="@color/func_gray_bg_3" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvReviewUser"
                style="@style/tv_black_1_size_14"
                android:layout_marginStart="@dimen/dp_8"
                tools:text="张*三" />

            <LinearLayout
                android:id="@+id/llReviewStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewContent"
            style="@style/tv_black_1_size_14"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/dp_10"
            android:lineSpacingExtra="@dimen/dp_2"
            tools:text="味道真的很赞，非常新鲜，顺丰快递送到家还是冰凉的，口感软糯。" />

        <LinearLayout
            android:id="@+id/llReviewImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
