<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/func_gray_bg_2"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/reviewListHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dp_48"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_12">

        <com.joy.common.widgets.IconFontView
            android:id="@+id/iconReviewListClose"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:gravity="center"
            android:text="@string/iconfont_close"
            android:textColor="@color/func_black_text_1"
            android:textSize="@dimen/dp_18" />

        <TextView
            android:id="@+id/tvReviewListTitle"
            style="@style/tv_black_1_size_16"
            android:layout_width="@dimen/dp_0"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:textStyle="bold"
            tools:text="宝贝评价 (856)" />

        <TextView
            android:id="@+id/tvReviewListPositiveRate"
            style="@style/tv_orange_1_size_12"
            tools:text="好评率 98%" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="@color/func_gray_bg_1" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/flReviewListTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_4"
        app:flexWrap="wrap"
        app:justifyContent="flex_start" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReviewList"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        tools:listitem="@layout/item_goods_review_list_row" />
</LinearLayout>
