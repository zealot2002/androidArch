<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/func_gray_bg_2"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorGoodsDetail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:clipChildren="false">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarGoodsDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="@dimen/dp_0"
            app:elevation="@dimen/dp_0">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingGoodsGallery"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_460"
                app:contentScrim="@android:color/transparent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:statusBarScrim="@android:color/transparent"
                app:titleEnabled="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_collapseMode="parallax">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpGallery"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvImageCount"
                        style="@style/tv_white_1_size_12"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_24"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:background="@drawable/bg_black_shape_rectangle_alpha1"
                        android:gravity="center"
                        android:minWidth="@dimen/dp_52"
                        android:paddingHorizontal="@dimen/dp_8"
                        tools:text="图片1/3" />
                </FrameLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetailContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/func_gray_bg_1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            tools:listitem="@layout/item_goods_detail_price_marketing" />

        <FrameLayout
            android:id="@+id/detailTitleOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/llTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:background="@color/func_gray_bg_2"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/goodsDetailTitleBarPaddingH">

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle2Back"
                        android:layout_width="@dimen/goodsDetailTitleActionSize"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:contentDescription="@string/goods_action_back"
                        android:gravity="center"
                        android:text="@string/iconfont_back"
                        android:textColor="@color/func_black_text_1"
                        android:textSize="@dimen/dp_20" />

                    <LinearLayout
                        android:id="@+id/layoutTitle2Search"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:layout_marginStart="@dimen/goodsDetailTitleActionGap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gray_fill_interact_1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/dp_12">

                        <com.joy.common.widgets.IconFontView
                            android:layout_width="@dimen/dp_18"
                            android:layout_height="@dimen/dp_18"
                            android:gravity="center"
                            android:text="@string/iconfont_search"
                            android:textColor="@color/func_black_text_4"
                            android:textSize="@dimen/dp_16" />

                        <TextView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_8"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/goods_detail_search_hint"
                            android:textColor="@color/func_black_text_4"
                            android:textSize="@dimen/dp_14" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/goodsDetailTitleTrailingActionsWidth"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal">

                        <com.joy.common.widgets.IconFontView
                            android:id="@+id/iconTitle2Favorite"
                            android:layout_width="@dimen/goodsDetailTitleActionSize"
                            android:layout_height="@dimen/goodsDetailTitleActionSize"
                            android:gravity="center"
                            android:text="@string/iconfont_follow_fill"
                            android:textColor="@color/func_black_text_1"
                            android:textSize="@dimen/dp_20" />

                        <com.joy.common.widgets.IconFontView
                            android:id="@+id/iconTitle2Share"
                            android:layout_width="@dimen/goodsDetailTitleActionSize"
                            android:layout_height="@dimen/goodsDetailTitleActionSize"
                            android:layout_marginStart="@dimen/goodsDetailTitleActionGap"
                            android:contentDescription="@string/goods_action_share"
                            android:gravity="center"
                            android:text="@string/iconfont_share"
                            android:textColor="@color/func_black_text_1"
                            android:textSize="@dimen/dp_20" />

                        <FrameLayout
                            android:id="@+id/flTitle2More"
                            android:layout_width="@dimen/goodsDetailTitleActionSize"
                            android:layout_height="@dimen/goodsDetailTitleActionSize"
                            android:layout_marginStart="@dimen/goodsDetailTitleActionGap">

                            <com.joy.common.widgets.IconFontView
                                android:id="@+id/iconTitle2More"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/goods_detail_more"
                                android:gravity="center"
                                android:text="@string/iconfont_more"
                                android:textColor="@color/func_black_text_1"
                                android:textSize="@dimen/dp_20" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp_8">

                    <TextView
                        android:id="@+id/tvTabProduct"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/goods_detail_tab_product"
                        android:textColor="@color/red_4"
                        android:textSize="@dimen/dp_15"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTabReview"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/goods_detail_tab_review"
                        android:textColor="@color/func_black_text_1"
                        android:textSize="@dimen/dp_15" />

                    <TextView
                        android:id="@+id/tvTabDetail"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/goods_detail_tab_detail"
                        android:textColor="@color/func_black_text_1"
                        android:textSize="@dimen/dp_15" />

                    <TextView
                        android:id="@+id/tvTabRecommend"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/goods_detail_tab_recommend"
                        android:textColor="@color/func_black_text_1"
                        android:textSize="@dimen/dp_15" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:background="@color/func_black_divider_1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/flTitle1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/goodsDetailTitleBarPaddingH">

                <com.joy.common.widgets.IconFontView
                    android:id="@+id/iconTitle1Back"
                    android:layout_width="@dimen/goodsDetailTitleActionSize"
                    android:layout_height="@dimen/goodsDetailTitleActionSize"
                    android:background="@drawable/bg_black_shape_circle_alpha1"
                    android:contentDescription="@string/goods_action_back"
                    android:gravity="center"
                    android:text="@string/iconfont_back"
                    android:textColor="@color/white_1"
                    android:textSize="@dimen/dp_18" />

                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_1"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="@dimen/goodsDetailTitleTrailingWidth"
                    android:layout_height="@dimen/goodsDetailTitleActionSize"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1Search"
                        android:layout_width="@dimen/goodsDetailTitleActionSize"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:gravity="center"
                        android:text="@string/iconfont_search"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_18" />

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1Favorite"
                        android:layout_width="@dimen/goodsDetailTitleActionSize"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:layout_marginStart="@dimen/goodsDetailTitleActionGap"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:gravity="center"
                        android:text="@string/iconfont_follow_fill"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_18" />

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1Share"
                        android:layout_width="@dimen/goodsDetailTitleActionSize"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:layout_marginStart="@dimen/goodsDetailTitleActionGap"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:contentDescription="@string/goods_action_share"
                        android:gravity="center"
                        android:text="@string/iconfont_share"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_18" />

                    <FrameLayout
                        android:id="@+id/flTitle1More"
                        android:layout_width="@dimen/goodsDetailTitleActionSize"
                        android:layout_height="@dimen/goodsDetailTitleActionSize"
                        android:layout_marginStart="@dimen/goodsDetailTitleActionGap">

                        <com.joy.common.widgets.IconFontView
                            android:id="@+id/iconTitle1More"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_black_shape_circle_alpha1"
                            android:contentDescription="@string/goods_detail_more"
                            android:gravity="center"
                            android:text="@string/iconfont_more"
                            android:textColor="@color/white_1"
                            android:textSize="@dimen/dp_18" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 与 Title1/Title2 渐变层分离：固定位置，不参与 alpha 交叉淡入 -->
        <com.joy.common.widgets.BadgeView
            android:id="@+id/tvMoreBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/goodsDetailTitleMoreBadgeMarginEnd"
            android:clickable="false"
            android:focusable="false"
            tools:layout_marginTop="@dimen/goodsDetailTitleMoreBadgeMarginTop"
            tools:visibility="visible" />

        <com.joy.common.widgets.ScrollToTopFloatView
            android:id="@+id/scrollToTopFloatView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_10" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/llBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/func_gray_bg_2"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/func_gray_divider_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_8">

            <LinearLayout
                android:id="@+id/layoutShop"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.joy.common.widgets.IconFontView
                    android:layout_width="@dimen/dp_22"
                    android:layout_height="@dimen/dp_22"
                    android:gravity="center"
                    android:text="@string/iconfont_shop"
                    android:textColor="@color/func_black_text_3"
                    android:textSize="@dimen/dp_20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/goods_action_shop"
                    android:textColor="@color/func_black_text_2"
                    android:textSize="@dimen/dp_10" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutService"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.joy.common.widgets.IconFontView
                    android:layout_width="@dimen/dp_22"
                    android:layout_height="@dimen/dp_22"
                    android:gravity="center"
                    android:text="@string/iconfont_service"
                    android:textColor="@color/func_black_text_3"
                    android:textSize="@dimen/dp_20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/goods_action_contact"
                    android:textColor="@color/func_black_text_2"
                    android:textSize="@dimen/dp_10" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutCart"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.joy.common.widgets.IconFontView
                        android:layout_width="@dimen/dp_22"
                        android:layout_height="@dimen/dp_22"
                        android:gravity="center"
                        android:text="@string/iconfont_cart"
                        android:textColor="@color/func_black_text_3"
                        android:textSize="@dimen/dp_20" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="@string/goods_action_cart"
                        android:textColor="@color/func_black_text_2"
                        android:textSize="@dimen/dp_10" />
                </LinearLayout>

                <com.joy.common.widgets.BadgeView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_6"
                    tools:text="3"
                    tools:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutPrimaryActions"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_40"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddCart"
                    style="@style/tv_white_1_size_14"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_orange_fill_interact_start_1"
                    android:gravity="center"
                    android:text="@string/goods_action_add_cart"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBuyNow"
                    style="@style/tv_white_1_size_14"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_red_fill_interact_end_1"
                    android:gravity="center"
                    android:text="@string/goods_action_buy_now"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <include
        android:id="@+id/reviewListPanelOverlay"
        layout="@layout/layout_goods_review_list_panel" />

</FrameLayout>
