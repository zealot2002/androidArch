<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_1"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinatorGoodsDetail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:clipChildren="false">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarGoodsDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="@dimen/dp_0"
            app:elevation="@dimen/dp_0">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingGoodsGallery"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_460"
                app:contentScrim="@android:color/transparent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:statusBarScrim="@android:color/transparent"
                app:titleEnabled="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_collapseMode="parallax">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpGallery"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvImageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_24"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="@dimen/dp_12"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:background="@drawable/bg_black_shape_rectangle_alpha1"
                        android:gravity="center"
                        android:minWidth="@dimen/dp_52"
                        android:paddingHorizontal="@dimen/dp_8"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_12"
                        tools:text="图片1/3" />
                </FrameLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetailContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gray_2"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <FrameLayout
            android:id="@+id/detailTitleOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/llTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:background="@color/gray_2"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp_14">

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle2Back"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:contentDescription="返回"
                        android:gravity="center"
                        android:text="@string/iconfont_back"
                        android:textColor="@color/black_1"
                        android:textSize="@dimen/dp_20" />

                    <LinearLayout
                        android:id="@+id/layoutTitle2Search"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_36"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gray_field_rect_1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/dp_12">

                        <com.joy.common.widgets.IconFontView
                            android:layout_width="@dimen/dp_18"
                            android:layout_height="@dimen/dp_18"
                            android:gravity="center"
                            android:text="@string/iconfont_search"
                            android:textColor="@color/black_4"
                            android:textSize="@dimen/dp_18" />

                        <TextView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_8"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="搜索商品"
                            android:textColor="@color/black_4"
                            android:textSize="@dimen/dp_14" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="@dimen/dp_36"
                        android:layout_marginStart="@dimen/dp_10"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal">

                        <com.joy.common.widgets.IconFontView
                            android:id="@+id/iconTitle2Favorite"
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:gravity="center"
                            android:text="@string/iconfont_favorite"
                            android:textColor="@color/black_1"
                            android:textSize="@dimen/dp_20" />

                        <com.joy.common.widgets.IconFontView
                            android:id="@+id/iconTitle2Share"
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:layout_marginStart="@dimen/dp_10"
                            android:contentDescription="分享"
                            android:gravity="center"
                            android:text="@string/iconfont_share"
                            android:textColor="@color/black_1"
                            android:textSize="@dimen/dp_20" />

                        <com.joy.common.widgets.IconFontView
                            android:id="@+id/iconTitle2More"
                            android:layout_width="@dimen/dp_36"
                            android:layout_height="@dimen/dp_36"
                            android:layout_marginStart="@dimen/dp_10"
                            android:gravity="center"
                            android:text="@string/iconfont_more"
                            android:textColor="@color/black_1"
                            android:textSize="@dimen/dp_20" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/dp_8">

                    <TextView
                        android:id="@+id/tvTabProduct"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="商品"
                        android:textColor="@color/red_4"
                        android:textSize="@dimen/dp_15"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTabReview"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="评价"
                        android:textColor="@color/black_1"
                        android:textSize="@dimen/dp_15" />

                    <TextView
                        android:id="@+id/tvTabDetail"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="详情"
                        android:textColor="@color/black_1"
                        android:textSize="@dimen/dp_15" />

                    <TextView
                        android:id="@+id/tvTabRecommend"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="推荐"
                        android:textColor="@color/black_1"
                        android:textSize="@dimen/dp_15" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:background="@color/gray_3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/flTitle1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_14">

                <com.joy.common.widgets.IconFontView
                    android:id="@+id/iconTitle1Back"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:background="@drawable/bg_black_shape_circle_alpha1"
                    android:contentDescription="返回"
                    android:gravity="center"
                    android:text="@string/iconfont_back"
                    android:textColor="@color/white_1"
                    android:textSize="@dimen/dp_20" />

                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_1"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="@dimen/dp_140"
                    android:layout_height="@dimen/dp_36"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1Search"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:gravity="center"
                        android:text="@string/iconfont_search"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_20" />

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1Favorite"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:layout_marginStart="@dimen/dp_10"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:gravity="center"
                        android:text="@string/iconfont_favorite"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_20" />

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1Share"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:layout_marginStart="@dimen/dp_10"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:contentDescription="分享"
                        android:gravity="center"
                        android:text="@string/iconfont_share"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_20" />

                    <com.joy.common.widgets.IconFontView
                        android:id="@+id/iconTitle1More"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:layout_marginStart="@dimen/dp_10"
                        android:background="@drawable/bg_black_shape_circle_alpha1"
                        android:gravity="center"
                        android:text="@string/iconfont_more"
                        android:textColor="@color/white_1"
                        android:textSize="@dimen/dp_20" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/scrollToTopFloatView"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_10"
            android:background="@drawable/bg_gray_fill_interact_1"
            android:gravity="center"
            android:text="↑"
            android:textColor="@color/black_1"
            android:textSize="@dimen/dp_20" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/llBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_2"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:background="@color/gray_3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_8">

            <LinearLayout
                android:id="@+id/layoutShop"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.joy.common.widgets.IconFontView
                    android:layout_width="@dimen/dp_22"
                    android:layout_height="@dimen/dp_22"
                    android:gravity="center"
                    android:text="@string/iconfont_home"
                    android:textColor="@color/black_2"
                    android:textSize="@dimen/dp_22" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="店铺"
                    android:textColor="@color/black_2"
                    android:textSize="@dimen/dp_10" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutService"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <com.joy.common.widgets.IconFontView
                    android:layout_width="@dimen/dp_22"
                    android:layout_height="@dimen/dp_22"
                    android:gravity="center"
                    android:text="@string/iconfont_service"
                    android:textColor="@color/black_2"
                    android:textSize="@dimen/dp_22" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="客服"
                    android:textColor="@color/black_2"
                    android:textSize="@dimen/dp_10" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/layoutCart"
                android:layout_width="@dimen/dp_48"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.joy.common.widgets.IconFontView
                        android:layout_width="@dimen/dp_22"
                        android:layout_height="@dimen/dp_22"
                        android:gravity="center"
                        android:text="@string/iconfont_cart"
                        android:textColor="@color/black_2"
                        android:textSize="@dimen/dp_22" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:text="购物车"
                        android:textColor="@color/black_2"
                        android:textSize="@dimen/dp_10" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/dp_6"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:background="@drawable/bg_red_fill_circle_1"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/white_1"
                    android:textSize="@dimen/dp_10" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutPrimaryActions"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_40"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAddCart"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_orange_fill_interact_start_1"
                    android:gravity="center"
                    android:text="加入购物车"
                    android:textColor="@color/white_1"
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBuyNow"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_red_fill_interact_end_1"
                    android:gravity="center"
                    android:text="立即购买"
                    android:textColor="@color/white_1"
                    android:textSize="@dimen/dp_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
